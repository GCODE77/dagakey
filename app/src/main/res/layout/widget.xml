<?xml version="1.0" encoding="utf-8"?>
<!-- 한 줄(1칸 높이) 위젯: [다가키(누르면 앱 열기)] [열기] [잠금] [트렁크] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="5dp" android:gravity="center_vertical"
    android:background="@drawable/widget_bg">
  <LinearLayout android:id="@+id/w_app" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15"
      android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_btn_app" android:layout_marginEnd="4dp">
    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@mipmap/ic_launcher"/>
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="다가키" android:textColor="#FF8C98A8" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/w_unlock" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
      android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_btn" android:layout_marginEnd="4dp">
    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_btn_unlock"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="열기"
        android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/w_lock" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
      android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_btn" android:layout_marginEnd="4dp">
    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_btn_lock"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="잠금"
        android:textColor="#FFEAF0F7" android:textSize="11sp" android:textStyle="bold"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/w_trunk" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
      android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_btn">
    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_btn_trunk"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="트렁크"
        android:textColor="#FFEAF0F7" android:textSize="11sp" android:textStyle="bold"/>
  </LinearLayout>
</LinearLayout>
