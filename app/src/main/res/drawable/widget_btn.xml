<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- 누르는 순간: 파란색으로 바뀜 -->
  <item android:state_pressed="true">
    <shape android:shape="rectangle"><solid android:color="#FF4C8DFF"/><corners android:radius="18dp"/></shape>
  </item>
  <!-- 평소: 세 버튼 모두 같은 색 (열기만 눌린 것처럼 보이던 문제 해결) -->
  <item>
    <shape android:shape="rectangle"><solid android:color="#FF1E2A3A"/><corners android:radius="18dp"/>
      <stroke android:width="1dp" android:color="#FF2C3B50"/></shape>
  </item>
</selector>
